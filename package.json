{
  "name": "mcp-indesign-agent",
  "version": "0.1.0",
  "description": "MCP server for editing Adobe InDesign via natural language in Cursor",
  "type": "module",
  "bin": {
    "mcp-indesign-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/probe-indesign.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "indesign",
    "adobe",
    "design",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
